# ---------------------------------------------------------------------------
# CoastGuard AI — template. Copy to .env.local and fill in the key.
#
# One key powers the chatbot on BOTH surfaces:
#   • the website assistant  (/assistant)  -> app/api/chat/route.ts
#   • the field app          (/mobile.html) -> posts to that same route
#
# After editing this file, restart the dev server so Next.js picks it up.
# ---------------------------------------------------------------------------

# Groq API key. Get one at https://console.groq.com/keys
# Stays server-side: it is never bundled into the browser build.
GROQ_API_KEY=

# Models the proxy is allowed to call. Leave as-is unless you know why.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Opt-in ONLY. Bakes the key into public/mobile.html at sync time so the
# single-file field app can reach Groq directly when it is opened straight
# from disk (file://) with no server in front of it.
#
# WARNING: anyone who opens that file can read the key. Leave this false
# unless you are demoing offline from a USB stick, and rotate the key after.
EMBED_GROQ_KEY_IN_MOBILE=false
